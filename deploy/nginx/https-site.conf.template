# HTTPS site for the panel — a template: deploy/enable-https.sh (Cloudflare
# Origin Certificate) and deploy/enable-letsencrypt.sh fill in __DOMAIN__,
# __APP_DIR__, __PHP_SOCK__, __CERT__ and __KEY__ from this installation.
#
# Plain HTTP on port 80 stays on the default site, which the ZKTeco
# attendance devices post to by IP.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root __APP_DIR__/public;
    index index.php;

    client_max_body_size 20m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:__PHP_SOCK__;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Never serve dotfiles (.env, .git, ...).
    location ~ /\.(?!well-known) {
        deny all;
    }
}
